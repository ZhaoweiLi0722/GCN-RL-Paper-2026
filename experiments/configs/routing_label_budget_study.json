{
  "name": "routing_label_budget_study",
  "experimental_role": "development-only measurement of a LABEL ESTIMATOR, not a policy experiment. Measures how reliably the best legal specimen action can be identified as a function of simulation budget and allocation scheme. No training, no checkpoint selection, no formal stream, no change to any existing result root.",
  "spec": "specs/2026-08-29-routing-label-budget-study/",
  "plan": "experiments/configs/patient_indexed_specimen_routing_benchmark.json",
  "anchor_algorithm": "mdl2",
  "scenarios": [
    "routing_nominal_history",
    "routing_abrupt_regime_shift",
    "routing_compound_regional_stress"
  ],
  "env_overrides": {
    "enable_specimen_routing": true,
    "enable_overtime_control": false,
    "enable_production_throttle": false
  },
  "state_generation": {
    "seeds": [
      98100000,
      98100001,
      98100002
    ],
    "fallback_seeds": [
      98100003,
      98100004
    ],
    "decision_epochs": [
      30,
      55,
      80
    ],
    "minimum_surviving_states": 18
  },
  "action_family": {
    "shifts": [
      0.0,
      -0.1,
      -0.05,
      0.05,
      0.1
    ],
    "pattern": "centred_pressure",
    "pattern_definition": "p = waiting - min(idle_bioreactors, reagents); mean-centred; scaled to unit max |.|",
    "filter": "all five arms must produce DISTINCT EXECUTED specimen flows at the state"
  },
  "worlds": {
    "seed_start": 98200000,
    "count": 64
  },
  "analysis": {
    "k_values": [
      1,
      2,
      4,
      8,
      16,
      32
    ],
    "splits_per_k": 200,
    "g1_budget_shape": [
      3,
      5
    ],
    "allocation_budgets_per_arm": [
      2,
      4,
      8,
      16
    ],
    "split_seed": 98300000
  },
  "reading_rule": {
    "underpowered_if_agreement_at_k32_at_least": 0.7,
    "fundamental_if_agreement_at_k32_below": 0.6,
    "fundamental_also_requires_last_doubling_gain_below": 0.02,
    "otherwise": "inconclusive_at_this_budget"
  },
  "output_root": "results/routing_label_budget_study"
}