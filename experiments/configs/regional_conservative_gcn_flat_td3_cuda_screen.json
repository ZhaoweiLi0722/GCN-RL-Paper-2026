{
  "name": "regional_conservative_gcn_flat_td3_cuda_screen",
  "plan": "experiments/configs/residual_policy_benchmark.json",
  "budget": "diagnostic_pretrain",
  "reference_scenario": "patient_condition_geo_regional_drift",
  "scenarios": [
    "patient_condition_geo_regional_drift"
  ],
  "teacher_cache": "results/regional_specialist_temporal_gcn_ddpg_onpolicy_dagger_iter2_seed0/teacher_train_dagger.npz",
  "demand_history_window": 12,
  "online_episodes": 100,
  "pretrain_epochs": 0,
  "offline_updates": 0,
  "seeds": [
    0,
    1,
    2
  ],
  "config_overrides": {
    "device": "cuda",
    "batch_size": 128,
    "actor_lr": 0.00001,
    "critic_lr": 0.0003,
    "critic_warmup_updates": 500,
    "policy_delay": 2,
    "policy_noise": 0.01,
    "noise_clip": 0.02,
    "actor_advantage_baseline": "reference",
    "reference_advantage_use_upper_confidence": true,
    "reference_policy_regularization_weight": 25.0,
    "actor_gradient_clip": 5.0,
    "critic_gradient_clip": 10.0,
    "progress_interval": 10,
    "include_adaptive_demand_features": true,
    "env": {
      "include_demand_sequence_state": true,
      "demand_sequence_length": 12
    },
    "temporal_demand_encoder": {
      "enabled": true,
      "hidden_size": 16
    },
    "train_randomization": {
      "enabled": false
    },
    "imitation_pretrain": {
      "enabled": false,
      "regularization_weight": 0.0,
      "regularization_batch_size": 128
    },
    "exploration_noise": {
      "theta": 0.15,
      "sigma": 0.005
    },
    "residual_action": {
      "group_scales": {
        "specimen_transfer": 0.0,
        "reagent_transfer": 0.1,
        "capacity_transfer": 0.1,
        "replenishment": 0.0
      },
      "endpoint_projection": {
        "enabled": true,
        "groups": [
          "reagent_transfer",
          "capacity_transfer"
        ],
        "max_endpoints_per_side": 1,
        "min_abs": 0.04
      },
      "pressure_projection": {
        "enabled": false,
        "groups": []
      }
    },
    "advantage_distillation_pretrain": {
      "retain_for_regularization": true,
      "populate_replay_buffer": false,
      "balance_label_weights": true,
      "early_stopping_patience": 1,
      "early_stopping_check_interval": 1,
      "early_stopping_min_delta": 0.00001,
      "early_stopping_gate_loss_weight": 0.5
    }
  },
  "algorithms": [
    {
      "name": "gcn_residual_mdl2_network_td3_bc",
      "seeds": [
        0,
        1,
        2
      ],
      "config_overrides": {
        "initial_checkpoint": "results/regional_cuda_pipeline/regional_cuda_stage3_dagger2/gcn_residual_mdl2_network_ddpg_afd/seed{seed}/checkpoints/gcn_residual_mdl2_network_ddpg_afd_seed{seed}_pretrain.pt"
      }
    },
    {
      "name": "flat_residual_mdl2_network_td3_bc",
      "seeds": [
        0,
        1,
        2
      ],
      "config_overrides": {
        "initial_checkpoint": "results/regional_cuda_pipeline/regional_cuda_stage3_dagger2/flat_residual_mdl2_network_ddpg_afd/seed{seed}/checkpoints/flat_residual_mdl2_network_ddpg_afd_seed{seed}_pretrain.pt",
        "hidden_sizes": [
          192,
          128,
          64
        ]
      }
    }
  ],
  "output_root": "results"
}
